# EquiLead — copy to .env and fill in. Never commit .env. No value here is a real credential.

# 1 = demonstration workspace seeded with synthetic applications (default). 0 = no seeding; SESSION_SECRET required.
DEMO_MODE=1

# Required when DEMO_MODE=0. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to 1 behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0

# Bind address for run.py
API_HOST=127.0.0.1
API_PORT=8000

# Optional: custom database URL (default: equilead-demo.sqlite3 next to app.py). Tests always use a temp file.
DATABASE_URL=

# Optional: requests per minute per client for POST routes (in-process limiter).
RATE_LIMIT_PER_MINUTE=30

# Optional: retention window for application records, in days (0 = keep forever). Applied by `python security.py purge`.
RETENTION_DAYS=0

# Optional: encrypted secrets file. See security.py. When set, values in secrets.enc fill empty variables above.
SECRETS_KEY=
SECRETS_FILE=secrets.enc

# Training (python train.py) — defaults shown; artifacts are written next to app.py and verified by SHA-256 at startup.
# TRAIN_ROWS=12000
# TRAIN_SEED=20260916
