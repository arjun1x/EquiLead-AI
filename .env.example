# EquiLead — copy to .env and fill in. Never commit .env.

# 1 = demo workspace with synthetic fixtures (default). 0 = research mode (fails closed without artifacts + key).
DEMO_MODE=1

# Required when DEMO_MODE=0. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Set to 1 behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# Bind address for run.py
API_HOST=127.0.0.1
API_PORT=8000

# Research mode only
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
MODEL_PATH=xgb_model.json
LABEL_ENCODERS_PATH=label_encoders.pkl
MODEL_CARD_PATH=model_card.json

# Optional: encrypted secrets file. See security.py. When set, values in secrets.enc override empty env vars.
SECRETS_KEY=
SECRETS_FILE=secrets.enc

# Optional: retention window for decision records, in days (0 = keep forever). Applied by `python security.py purge`.
RETENTION_DAYS=0

# Optional: requests per minute per client for POST routes.
RATE_LIMIT_PER_MINUTE=30

# Optional: custom database URL (default: sqlite file next to app.py)
DATABASE_URL=
